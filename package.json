{
  "name": "opencode-mobile",
  "main": "expo-router/entry",
  "version": "1.0.11",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "build:web:ci": "expo export --platform web --output-dir dist-e2e",
    "serve:web:ci": "npm run build:web:ci && serve -s dist-e2e -l 19006",
    "android": "expo run:android",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:fake-server": "node ./tests/fake-opencode/server.mjs",
    "test:fake-server:self": "node ./tests/fake-opencode/self-test.mjs",
    "test:usage": "node ./tests/usage.test.mjs",
    "test:format": "node ./tests/format.test.mjs",
    "test:provider-utils": "node ./tests/provider-utils.test.mjs",
    "test:workspace-patch": "node ./tests/workspace-patch.test.mjs",
    "test:e2e:web": "playwright test",
    "test:ci:static": "npm run lint && npm run typecheck && npm run test:usage && npm run test:format && npm run test:provider-utils && npm run test:workspace-patch",
    "build:android": "node ./scripts/build-android-release.mjs",
    "build:development:android": "node ./scripts/build-android-development.mjs",
    "ios": "expo run:ios",
    "prebuild:ios": "expo prebuild --platform ios --non-interactive",
    "build:ios:local": "node ./scripts/build-ios-release.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@opencode-ai/sdk": "^1.18.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@shopify/flash-list": "2.0.2",
    "base-64": "^1.0.0",
    "expo": "~54.0.37",
    "expo-av": "^16.0.8",
    "expo-background-task": "~1.0.10",
    "expo-brightness": "~14.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-intent-launcher": "~13.0.8",
    "expo-keep-awake": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-speech": "~14.0.7",
    "expo-speech-recognition": "^3.1.2",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-paper": "^5.15.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "serve": "^14.2.4",
    "typescript": "~5.9.2",
    "ws": "^8.21.1"
  },
  "private": true
}
