{
  "name": "opencode-mobile",
  "main": "expo-router/entry",
  "version": "1.0.52",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "build:web:ci": "expo export --platform web --output-dir dist-e2e --clear",
    "serve:web:ci": "npm run build:web:ci && serve -s dist-e2e -l 19006",
    "android": "expo run:android",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:fake-server": "node ./tests/fake-opencode/server.mjs",
    "test:fake-server:self": "node ./tests/fake-opencode/self-test.mjs",
    "test:usage": "node ./tests/usage.test.mjs",
    "test:chat-appearance": "node ./tests/chat-appearance.test.mjs",
    "test:vitest": "vitest run",
    "test:i18n": "node ./tests/i18n.test.mjs",
    "test:i18n:loose": "node ./tests/i18n.test.mjs --allow-missing",
    "test:architecture": "node ./tests/architecture.test.mjs",
    "test:anr": "node ./tests/anr-regressions.test.mjs",
    "gen:i18n": "node ./scripts/gen-i18n.mjs",
    "test:provider-utils": "node ./tests/provider-utils.test.mjs",
    "test:voice-errors": "node ./tests/voice-errors.test.mjs",
    "test:credential-storage": "node ./tests/credential-storage.test.mjs",
    "test:persistence-hydration": "node ./tests/persistence-hydration.test.mjs",
    "test:session-cache": "node ./tests/session-cache.test.mjs",
    "test:favorites": "node ./tests/favorites.test.mjs",
    "test:connection-scope": "node ./tests/connection-scope.test.mjs",
    "test:connection-profiles": "node ./tests/connection-profiles.test.mjs",
    "test:last-session": "node ./tests/last-session.test.mjs",
    "test:active-sessions": "node ./tests/active-sessions.test.mjs",
    "test:notifications": "node ./tests/notifications.test.mjs",
    "test:notifications-background": "node ./tests/notifications-background.test.mjs",
    "test:workspace-patch": "node ./tests/workspace-patch.test.mjs",
    "test:onboarding": "node ./tests/onboarding.test.mjs",
    "test:e2e:web": "playwright test",
    "test:ci:static": "npm run lint && npm run typecheck && npm run test:usage && npm run test:chat-appearance && npm run test:vitest && npm run test:i18n && npm run test:provider-utils && npm run test:voice-errors && npm run test:workspace-patch && npm run test:persistence-hydration && npm run test:credential-storage && npm run test:session-cache && npm run test:favorites && npm run test:connection-scope && npm run test:connection-profiles && npm run test:last-session && npm run test:active-sessions && npm run test:notifications && npm run test:notifications-background && npm run test:onboarding && npm run test:connect && npm run test:anr && npm run test:architecture && npm run test:provider-runtime",
    "build:android": "node ./scripts/build-android-release.mjs",
    "build:foss:android": "OPENCODE_BUILD_FLAVOR=foss node ./scripts/build-android-release.mjs",
    "build:development:android": "node ./scripts/build-android-development.mjs",
    "ios": "expo run:ios",
    "prebuild:ios": "expo prebuild --platform ios --non-interactive",
    "build:ios:local": "node ./scripts/build-ios-release.mjs",
    "test:connect": "node ./tests/connect.test.mjs",
    "test:provider-runtime": "node ./tests/provider-runtime.test.mjs",
    "test:foss": "node ./tests/foss-prepare.test.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@opencode-ai/sdk": "^1.18.3",
    "@opencode/client": "^2.0.16",
