{
  "name": "opencode-mobile",
  "main": "expo-router/entry",
  "version": "1.0.21",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "build:web:ci": "expo export --platform web --output-dir dist-e2e",
    "serve:web:ci": "npm run build:web:ci && serve -s dist-e2e -l 19006",
    "android": "expo run:android",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:fake-server": "node ./tests/fake-opencode/server.mjs",
    "test:fake-server:self": "node ./tests/fake-opencode/self-test.mjs",
    "test:usage": "node ./tests/usage.test.mjs",
    "test:format": "node ./tests/format.test.mjs",
    "test:record-preservation": "node ./tests/record-preservation.test.mjs",
    "test:provider-utils": "node ./tests/provider-utils.test.mjs",
    "test:credential-storage": "node ./tests/credential-storage.test.mjs",
    "test:persistence-hydration": "node ./tests/persistence-hydration.test.mjs",
    "test:session-cache": "node ./tests/session-cache.test.mjs",
    "test:favorites": "node ./tests/favorites.test.mjs",
    "test:workspace-patch": "node ./tests/workspace-patch.test.mjs",
    "test:e2e:web": "playwright test",
    "test:ci:static": "npm run lint && npm run typecheck && npm run test:usage && npm run test:format && npm run test:provider-utils && npm run test:workspace-patch && npm run test:session-cache && npm run test:favorites",
    "build:android": "node ./scripts/build-android-release.mjs",
    "build:development:android": "node ./scripts/build-android-development.mjs",
    "ios": "expo run:ios",
    "prebuild:ios": "expo prebuild --platform ios --non-interactive",
    "build:ios:local": "node ./scripts/build-ios-release.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@opencode-ai/sdk": "^1.18.3",
    "@opencode/client": "^2.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.0.2",
    "base-64": "^1.0.0",
    "expo": "^57.0.24",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-background-task": "~57.0.19",
    "expo-brightness": "~57.0.2",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-intent-launcher": "~57.0.1",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-speech": "~57.0.3",
    "expo-speech-recognition": "^57.1.0",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.19",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-paper": "5.15.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/react": "~19.2.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "serve": "^14.2.4",
    "typescript": "~6.0.3",
    "ws": "^8.21.1"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "private": true
}
