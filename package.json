{
  "name": "opencode-mobile",
  "main": "index.js",
  "version": "1.0.96",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "build:web:ci": "expo export --platform web --output-dir dist-e2e --clear",
    "build:web:e2e": "node ./scripts/build-web-e2e.mjs",
    "serve:web:ci": "npm run build:web:ci && serve -s dist-e2e -l 19006",
    "android": "expo run:android",
    "web": "expo start --web",
    "lint": "eslint . --cache --cache-strategy content",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile tsconfig.app.tsbuildinfo",
    "typecheck:tests": "tsc -p tsconfig.tests.json --incremental --tsBuildInfoFile tsconfig.tests.tsbuildinfo",
    "gen:i18n": "node ./scripts/gen-i18n.mjs",
    "test:vitest": "vitest run",
    "test:i18n:loose": "I18N_ALLOW_MISSING=1 vitest run tests/vitest/i18n.test.ts",
    "test:fake-server": "node ./tests/fake-opencode/server.mjs",
    "test:fake-server:v1": "node ./tests/fake-opencode/server-v1.mjs",
    "test:fake-server:self": "node ./tests/fake-opencode/self-test.mjs",
    "test:e2e:web": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:last-failed": "playwright test --last-failed",
    "test:e2e:web:isolated": "node ./scripts/e2e-isolated.mjs",
    "serve:web:prebuilt": "node ./scripts/serve-web-prebuilt.mjs",
    "validate:fast": "npm run test:ci:static && npm run test:fake-server:self && npm run test:e2e:smoke",
    "test:ci:static": "node ./tests/run-static.mjs",
    "build:android": "node ./scripts/build-android-release.mjs",
    "build:foss:android": "OPENCODE_BUILD_FLAVOR=foss node ./scripts/build-android-release.mjs",
    "build:development:android": "node ./scripts/build-android-development.mjs",
    "ios": "expo run:ios",
    "ios:personal-team": "EXPO_IOS_DISABLE_PUSH_ENTITLEMENT=1 expo prebuild --platform ios && EXPO_IOS_DISABLE_PUSH_ENTITLEMENT=1 expo run:ios",
    "prebuild:ios": "expo prebuild --platform ios --non-interactive",
    "build:ios:local": "node ./scripts/build-ios-release.mjs",
    "test:foss": "node ./tests/foss-prepare.test.mjs",
    "preview:workspaces": "EXPO_PUBLIC_E2E_MODE=1 EXPO_APP_VARIANT=development npm run build:web:ci && node ./tests/fake-opencode/preview-workspaces.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@opencode-ai/sdk": "^1.18.3",
    "@opencode/client": "^2.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@shopify/flash-list": "2.0.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "base-64": "^1.0.0",
    "expo": "^57.0.24",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-background-task": "~57.0.19",
    "expo-build-properties": "~57.0.20",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-iap": "5.8.2",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-intent-launcher": "~57.0.1",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.20",
    "expo-quick-actions": "^6.0.2",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-speech": "~57.0.3",
    "expo-speech-recognition": "^57.1.0",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.19",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.15",
    "react-native": "0.86.3",
    "react-native-android-widget": "^0.22.1",
    "react-native-enriched-markdown": "^1.0.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-paper": "5.15.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/react": "~19.2.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "serve": "^14.2.4",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "ws": "^8.21.1"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    },
    "shell-quote": "^1.11.0",
    "source-map-js": "^1.2.2",
    "compression": "^1.8.2",
    "decode-uri-component": "^0.5.0",
    "@expo/require-utils": {
      "typescript": "$typescript"
    }
  },
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": ["expo-sharing"]
      }
    }
  }
}
