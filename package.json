{
  "name": "opencode-mobile",
  "main": "index.js",
  "version": "1.0.109",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "build:web:ci": "expo export --platform web --output-dir dist-e2e --clear",
    "build:web:e2e": "node ./scripts/build-web-e2e.mjs",
    "serve:web:ci": "npm run build:web:ci && serve -s dist-e2e -l 19006",
    "android": "expo run:android",
    "web": "expo start --web",
    "lint": "eslint . --cache --cache-strategy content",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile tsconfig.app.tsbuildinfo",
    "typecheck:tests": "tsc -p tsconfig.tests.json --incremental --tsBuildInfoFile tsconfig.tests.tsbuildinfo",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "gen:i18n": "node ./scripts/gen-i18n.mjs",
    "test:vitest": "vitest run",
    "test:docs": "vitest run tests/vitest/docs.test.ts",
    "test:i18n:loose": "I18N_ALLOW_MISSING=1 vitest run shared/i18n/__tests__/i18n.test.ts",
    "test:fake-server": "node ./tests/fake-opencode/server.mjs",
    "test:fake-server:v1": "node ./tests/fake-opencode/server-v1.mjs",
    "test:fake-server:self": "node ./tests/fake-opencode/self-test.mjs",
    "test:e2e:web": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:last-failed": "playwright test --last-failed",
    "test:e2e:changed": "node ./scripts/ci/run-changed-e2e.mjs",
    "test:e2e:budget": "node ./scripts/ci/check-e2e-budget.mjs",
    "test:e2e:web:isolated": "node ./scripts/e2e-isolated.mjs",
    "serve:web:prebuilt": "node ./scripts/serve-web-prebuilt.mjs",
    "validate:fast": "npm run test:ci:static && npm run test:fake-server:self && npm run test:e2e:budget && npm run test:e2e:smoke",
    "test:ci:static": "node ./tests/run-static.mjs",
    "build:android": "node ./scripts/build-android-release.mjs",
    "build:foss:android": "OPENCODE_BUILD_FLAVOR=foss node ./scripts/build-android-release.mjs",
    "build:development:android": "node ./scripts/build-android-development.mjs",
    "ios": "expo run:ios",
    "ios:personal-team": "EXPO_IOS_DISABLE_PUSH_ENTITLEMENT=1 expo prebuild --platform ios && EXPO_IOS_DISABLE_PUSH_ENTITLEMENT=1 expo run:ios",
    "prebuild:ios": "expo prebuild --platform ios --non-interactive",
    "build:ios:local": "node ./scripts/build-ios-release.mjs",
    "test:foss": "node ./tests/foss-prepare.test.mjs",
    "preview:workspaces": "EXPO_PUBLIC_E2E_MODE=1 EXPO_APP_VARIANT=development npm run build:web:ci && node ./tests/fake-opencode/preview-workspaces.mjs",
    "postinstall": "patch-package",
    "gen:ui-tokens": "node ./scripts/gen-ui-tokens.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "5.2.2",
    "@opencode-ai/sdk": "^1.18.3",
    "@opencode/client": "^2.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "5.2.1",
    "@rn-primitives/alert-dialog": "1.5.2",
    "@rn-primitives/checkbox": "1.5.2",
    "@rn-primitives/collapsible": "1.5.2",
    "@rn-primitives/dialog": "1.5.2",
    "@rn-primitives/label": "1.5.2",
    "@rn-primitives/portal": "1.5.3",
    "@rn-primitives/progress": "1.5.2",
    "@rn-primitives/radio-group": "1.5.2",
    "@rn-primitives/select": "1.5.2",
    "@rn-primitives/separator": "1.5.2",
    "@rn-primitives/slot": "1.5.2",
    "@rn-primitives/switch": "1.5.2",
    "@rn-primitives/tabs": "1.5.2",
    "@rn-primitives/toast": "1.5.2",
    "@rn-primitives/toggle": "1.5.2",
    "@rn-primitives/toggle-group": "1.5.2",
    "@scure/base": "^1.2.6",
    "@shopify/flash-list": "2.3.2",
    "@siteed/sherpa-onnx.rn": "1.3.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "expo": "58.0.22",
    "expo-application": "58.1.2",
    "expo-asset": "58.0.19",
    "expo-audio": "58.0.11",
    "expo-background-task": "58.0.12",
    "expo-build-properties": "58.0.12",
    "expo-camera": "58.0.14",
    "expo-clipboard": "58.0.4",
    "expo-constants": "58.0.14",
    "expo-crypto": "58.0.7",
    "expo-dev-client": "58.0.18",
    "expo-document-picker": "58.0.4",
    "expo-file-system": "58.0.13",
    "expo-font": "58.0.11",
    "expo-haptics": "58.0.7",
    "expo-iap": "5.8.2",
    "expo-image": "58.0.18",
    "expo-image-manipulator": "58.0.16",
    "expo-intent-launcher": "58.0.3",
    "expo-keep-awake": "58.0.3",
    "expo-linking": "58.0.15",
    "expo-localization": "58.0.5",
    "expo-notifications": "58.1.7",
    "expo-quick-actions": "^6.0.2",
    "expo-router": "58.0.29",
    "expo-secure-store": "58.0.2",
    "expo-sharing": "58.0.21",
    "expo-speech": "58.0.3",
    "expo-speech-recognition": "58.0.1",
    "expo-splash-screen": "58.0.12",
    "expo-status-bar": "58.0.4",
    "expo-store-review": "58.0.2",
    "expo-symbols": "58.0.4",
    "expo-system-ui": "58.0.7",
    "expo-task-manager": "58.0.13",
    "expo-video": "58.0.13",
    "expo-web-browser": "58.0.7",
    "i18next": "^26.4.2",
    "jsonc-parser": "^3.3.1",
    "llama.rn": "0.12.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.91.0",
    "react-i18next": "^17.0.15",
    "react-native": "0.88.1",
    "react-native-android-widget": "^0.22.1",
    "react-native-enriched-markdown": "^1.0.2",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "uniwind": "1.13.1",
    "zod": "^4.6.7",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@tanstack/react-query": "5.105.0",
    "expo-in-app-updates": "0.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@react-native/babel-preset": "0.88.1",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@types/react": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "58.0.4",
    "patch-package": "^8.0.1",
    "serve": "^14.2.4",
    "storybook": "^10.6.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "ws": "^8.21.1",
    "@tailwindcss/vite": "4.3.3",
    "@react-native-reusables/cli": "0.7.1",
    "@react-native/metro-config": "0.88.1",
    "expo-mcp": "0.2.4"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    },
    "shell-quote": "^1.11.0",
    "source-map-js": "^1.2.2",
    "compression": "^1.8.2",
    "decode-uri-component": "^0.5.0",
    "@expo/require-utils": {
      "typescript": "$typescript"
    }
  },
  "private": true,
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-sharing"
        ]
      }
    }
  }
}
