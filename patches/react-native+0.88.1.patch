+package com.facebook.react.views.text
+
+import android.content.res.Configuration
+import android.text.TextPaint
+import android.widget.TextView
+import com.facebook.react.bridge.JavaOnlyMap
+import com.facebook.react.uimanager.ReactStylesDiffMap
+import org.assertj.core.api.Assertions.assertThat
+import org.junit.After
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34])
+class TextLayoutManagerSystemDefaultTypefaceTest {
+  @Before
+  fun setUp() {
+    setCachedTypefaceConfiguration(null)
+    setCachedTypeface(null)
+  }
+
+  @After
+  fun tearDown() {
+    setCachedTypefaceConfiguration(null)
+    setCachedTypeface(null)
+  }
+
+  @Test
+  fun `plain text after explicit font uses rendering TextView typeface`() {
+    val context = RuntimeEnvironment.getApplication()
+    val paint = TextPaint(TextPaint.ANTI_ALIAS_FLAG)
+    val explicitAttributes = attributes(JavaOnlyMap.of("fontFamily", "serif"))
+    val plainAttributes = attributes(JavaOnlyMap())
+
+    TextLayoutManager.updateTextPaint(paint, explicitAttributes, context.assets, 0, context)
+    paint.setTypeface(null)
+    TextLayoutManager.updateTextPaint(paint, plainAttributes, context.assets, 0, context)
+
+    assertThat(paint.typeface).isEqualTo(TextView(context).typeface)
+  }
+
+  @Test
+  fun `default typeface cache refreshes after configuration changes`() {
+    val context = RuntimeEnvironment.getApplication()
+    val originalConfiguration = Configuration(context.resources.configuration)
+    val plainAttributes = attributes(JavaOnlyMap())
+
+    try {
+      TextLayoutManager.updateTextPaint(
+          TextPaint(TextPaint.ANTI_ALIAS_FLAG), plainAttributes, context.assets, 0, context)
+      val cachedBefore = cachedTypefaceConfiguration()
+      val updatedConfiguration = Configuration(originalConfiguration).apply {
+        fontScale = originalConfiguration.fontScale + 0.25f
+      }
+      context.resources.updateConfiguration(updatedConfiguration, context.resources.displayMetrics)
+
+      val paint = TextPaint(TextPaint.ANTI_ALIAS_FLAG)
+      TextLayoutManager.updateTextPaint(paint, plainAttributes, context.assets, 0, context)
+
+      assertThat(cachedTypefaceConfiguration()).isEqualTo(context.resources.configuration)
+      assertThat(cachedTypefaceConfiguration()).isNotEqualTo(cachedBefore)
+      assertThat(paint.typeface).isEqualTo(TextView(context).typeface)
+    } finally {
+      context.resources.updateConfiguration(originalConfiguration, context.resources.displayMetrics)
+    }
+  }
+
+  private fun attributes(map: JavaOnlyMap) =
+      TextAttributeProps.fromReadableMap(ReactStylesDiffMap(map))
+
+  private fun cachedTypefaceConfiguration(): Configuration? =
+      TextLayoutManager::class.java
+          .getDeclaredField("sSystemDefaultTypefaceConfiguration")
+          .apply { isAccessible = true }
+          .get(TextLayoutManager) as Configuration?
+
+  private fun setCachedTypefaceConfiguration(configuration: Configuration?) {
+    TextLayoutManager::class.java
+        .getDeclaredField("sSystemDefaultTypefaceConfiguration")
+        .apply { isAccessible = true }
+        .set(TextLayoutManager, configuration)
+  }
+
+  private fun setCachedTypeface(typeface: android.graphics.Typeface?) {
+    TextLayoutManager::class.java
+        .getDeclaredField("sSystemDefaultTypeface")
+        .apply { isAccessible = true }
+        .set(TextLayoutManager, typeface)
+  }
+}
