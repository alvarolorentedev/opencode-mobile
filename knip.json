{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    ".storybook/stubs/**/*.{js,tsx}",
    "{features,shared}/**/*.{native,web,ios,android}.{ts,tsx}",
    "shared/platform/foss/**/*.{ts,tsx}",
    "tests/integration/*.test.{ts,tsx}",
    "tests/integration/fixtures/command-plugin.mjs"
  ],
  "ignoreDependencies": [
    "@expo/config-plugins",
    "@opencode/plugin",
    "@react-native-reusables/cli",
    "expo-mcp",
    "expo-updates",
    "@react-native/babel-preset"
  ],
  "ignoreBinaries": [
    "keytool"
  ],
  "ignoreIssues": {
    ".storybook/**": [
      "exports",
      "types",
      "duplicates"
    ],
    "config/**": [
      "exports",
      "types",
      "duplicates"
    ],
    "tests/**": [
      "exports",
      "types",
      "duplicates"
    ],
    "shared/i18n/resources.ts": [
      "exports",
      "types",
      "duplicates"
    ],
    "features/*/index.ts": [
      "exports",
      "types"
    ],
    "features/*/runtime.ts": [
      "exports",
      "types"
    ],
    "shared/ui/**": [
      "exports",
      "types"
    ],
    "shared/contracts/**": [
      "exports",
      "types"
    ],
    "shared/protocol/opencode/client.ts": [
      "exports",
      "types"
    ],
    "shared/protocol/opencode/types.ts": [
      "exports",
      "types"
    ],
    "features/onboarding/model/onboarding-state.ts": [
      "exports",
      "types"
    ],
    "features/widgets/ui/session-widget.tsx": [
      "exports",
      "types"
    ],
    "features/extensions/model/types.ts": [
      "exports",
      "types"
    ],
    "features/projects/model/action-inputs.ts": [
      "exports",
      "types"
    ],
    "features/sessions/model/types.ts": [
      "exports",
      "types"
    ],
    "features/sessions/state/use-approvals-catalog.ts": [
      "exports",
      "types"
    ],
    "features/sessions/state/use-session-catalog.ts": [
      "exports",
      "types"
    ]
  }
}
