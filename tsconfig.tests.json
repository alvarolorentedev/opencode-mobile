{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "tests/vitest/**/*.ts",
    "base-64.d.ts",
    "expo-env.d.ts",
    "global.d.ts",
    "uniwind-types.d.ts",
    ".expo/types/**/*.ts",
    "features/**/__tests__/**/*.ts",
    "shared/**/__tests__/**/*.ts",
    "runtime/**/__tests__/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/._*"
  ]
}
