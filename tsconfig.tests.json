{
  // Type-checks the Vitest suites that are clean today. The suites listed under
  // `exclude` drive the dynamic `loadTs` / `hookRuntime` harness in
  // tests/helpers/runtime.mjs and would need a typed harness before they can be
  // added. Shrink this list as suites are cleaned up; never add to it without a
  // note in docs/known-gaps.md.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "tests/vitest/**/*.ts",
    "base-64.d.ts",
    "expo-env.d.ts",
    ".expo/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "tests/vitest/active-sessions.test.ts",
    "tests/vitest/activity-notifications.test.ts",
    "tests/vitest/anr-regressions.test.ts",
    "tests/vitest/app-updates.test.ts",
    "tests/vitest/audit-races.test.ts",
    "tests/vitest/connect-camera-gate.test.ts",
    "tests/vitest/connect-recovery.test.ts",
    "tests/vitest/connect.test.ts",
    "tests/vitest/connection-dialog.test.ts",
    "tests/vitest/connection-profiles.test.ts",
    "tests/vitest/feed.test.ts",
    "tests/vitest/native-intent.test.ts",
    "tests/vitest/notifications-background.test.ts",
    "tests/vitest/persistence-hydration.test.ts",
    "tests/vitest/provider-runtime.test.ts",
    "tests/vitest/provider-utils.test.ts",
    "tests/vitest/read-deadline.test.ts",
    "tests/vitest/services-management.test.ts",
    "tests/vitest/share-flow.test.ts",
    "tests/vitest/share-ui.test.ts",
    "tests/vitest/terminal.test.ts",
    "tests/vitest/v2-mappers.test.ts",
    "tests/vitest/widget-flow.test.ts"
  ]
}
